{
    "server": {
        "port": "55432"
    },
    "collector": {
        "cpu": {
            "interval": 5,
            "history_size": 100
        },
        "disk": {
            "interval": 10,
            "history_size": 100
        },
        "memory": {
            "interval": 5,
            "history_size": 100
        },
        "network": {
            "targets": [
                {
                    "name": "Google",
                    "addr": "google.com/robots.txt",
                    "type": "https",
                    "interval": 10,
                    "timeout": 2
                },
                {
                    "name": "Instagram",
                    "addr": "instagram.com/robots.txt",
                    "type": "https",
                    "interval": 10,
                    "timeout": 2
                },
                {
                    "name": "YouTube",
                    "addr": "youtube.com/robots.txt",
                    "type": "https",
                    "interval": 10,
                    "timeout": 2
                },
                {
                    "name": "Local router",
                    "addr": "192.168.0.1",
                    "type": "http",
                    "interval": 10
                },
                {
                    "name": "Cloudflare DNS",
                    "addr": "1.1.1.1:53",
                    "type": "dns",
                    "interval": 10
                },
                {
                    "name": "Google DNS",
                    "addr": "8.8.8.8:53",
                    "type": "dns",
                    "interval": 10
                },
                {
                    "name": "Quad9 DNS",
                    "addr": "9.9.9.9:53",
                    "type": "dns",
                    "interval": 10
                }
            ]
        },
        "system": {
            "interval": 10
        }
    }
}